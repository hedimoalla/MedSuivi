# Copier ce fichier en .env (ne jamais le committer).

# Base PostgreSQL (Neon en local, base Render en production).
# En production, ajouter ?sslmode=require si le fournisseur l'exige.
# Chemin du certificat racine Supabase (en local : fichier hors dépôt ; sur Render : /etc/secrets/supabase-ca.crt)
DATABASE_CA_PATH=
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/medsuivi?sslmode=require

# Longue chaîne aléatoire : openssl rand -base64 48
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres

# Identifiants OAuth « Application Web » (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# http://localhost:3000 en local, https://<service>.onrender.com en production
APP_BASE_URL=http://localhost:3000

# Adresses Google autorisées, séparées par des virgules
ALLOWED_EMAILS=moi@gmail.com,frere@gmail.com,mere@gmail.com

# Administrateur(s) : seuls eux peuvent modifier la liste des médicaments (sous-ensemble de ALLOWED_EMAILS)
ADMIN_EMAILS=moi@gmail.com

# Ne fonctionne qu'avec NODE_ENV=development. Connexion locale sans Google.
NODE_ENV=development
DEV_AUTH_BYPASS=false

PORT=3000
TZ=Africa/Tunis
